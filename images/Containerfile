# Foreman's agent image, phase 1: one image for every project, built by Foreman
# as localhost/foreman/harness (wiki/product/architecture/tech-stack.md#agent-images).
# A basic Debian box (adapted from pclaude's Dockerfile, github.com/brickpop/pclaude):
# Node, Bun, Go, Python 3 with uv (no pip or venv: uv covers both), just, the wiki CLI and common shell tools; anything more specialised
# comes from a project override later. The harnesses (Claude Code,
# Pi, Codex) are installed last, so updating them reuses every layer above.
# foreman-agent joins with the agent link.

# uv, Python's package and project manager, from Astral's own image, pinned via
# build arg or "latest".
ARG UV_VERSION=latest
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM docker.io/library/node:26-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      openssh-client \
      less \
      jq \
      make \
      unzip \
      just \
      procps \
      python3 \
  && rm -rf /var/lib/apt/lists/*

# Go, pinned via build arg or resolved at build time with "latest". The
# stdlib's own tests (test/, api/, every testdata/) are dropped: building and
# testing a project never reads them.
ARG GO_VERSION=latest
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    ver="$GO_VERSION"; \
    if [ "$ver" = "latest" ]; then ver="$(curl -fsSL https://go.dev/VERSION?m=text | head -n1)"; fi; \
    case "$ver" in go*) ;; *) ver="go$ver" ;; esac; \
    curl -fsSL "https://go.dev/dl/${ver}.linux-${arch}.tar.gz" | tar -C /usr/local -xz; \
    rm -rf /usr/local/go/test /usr/local/go/api; \
    find /usr/local/go/src -type d -name testdata -prune -exec rm -rf {} +; \
    /usr/local/go/bin/go version

# The wiki CLI, pinned via build arg (a release tag, e.g. v0.24.0) or the latest
# release. Keep it the version go.mod requires for github.com/agentic-wiki/wiki:
# the agents' CLI and Foreman's library must read a wiki by the same rules
# (TestWikiVersionMatchesGoMod). Only a tag with a GitHub release has binaries.
ARG WIKI_VERSION=v0.24.0
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    if [ "$WIKI_VERSION" = "latest" ]; then from="latest/download"; else from="download/${WIKI_VERSION}"; fi; \
    curl -fsSL "https://github.com/agentic-wiki/wiki/releases/${from}/wiki_linux_${arch}.tar.gz" \
      | tar -xz -C /usr/local/bin wiki

COPY --from=uv /uv /uvx /usr/local/bin/

ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global \
    GOPATH=/home/node/go \
    BUN_INSTALL=/home/node/.bun \
    PATH=/usr/local/share/npm-global/bin:/usr/local/go/bin:/home/node/go/bin:/home/node/.bun/bin:$PATH

RUN mkdir -p /usr/local/share/npm-global /home/node/.claude \
  && chown -R node:node /usr/local/share/npm-global /home/node/.claude

USER node

RUN curl -fsSL https://bun.sh/install | bash

# Last, because it moves fastest: a version bump reuses every layer above.
# Installed with npm because that is how Claude Code, Pi and Codex are distributed; this runs
# inside the agent image only (the Bun-only rule is about Foreman's own UI build).
# Each layer drops npm's cache and logs (~/.npm) in the same step, or they stay in it.
ARG CLAUDE_CODE_VERSION=latest
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
  && rm -rf ~/.npm

# Pi, the second harness (internal/harness/pi). Its install scripts aren't
# needed (Pi's own instructions skip them).
ARG PI_VERSION=latest
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@${PI_VERSION} \
  && rm -rf ~/.npm

# Codex CLI, the third harness (internal/harness/codex). Its voice host (no
# audio in a container) and its code-mode host (a feature Foreman doesn't
# enable) are ~125 MB of helpers, removed (wiki/technical-debt.md).
ARG CODEX_VERSION=latest
RUN npm install -g @openai/codex@${CODEX_VERSION} \
  && rm -rf ~/.npm \
  && cd "$(npm root -g)/@openai/codex/node_modules/@openai" \
  && rm -rf codex-linux-*/vendor/*/codex-resources/voice codex-linux-*/vendor/*/bin/codex-code-mode-host

# A throwaway HOME, so whatever the harnesses write when they first run isn't
# baked into the image.
RUN export HOME="$(mktemp -d)" \
  && node --version && bun --version && go version && python3 --version && uv --version \
  && claude --version && pi --version && codex --version && wiki --version \
  && rm -rf "$HOME"

# The command is exactly what Foreman passes, and defaults to Claude.
ENTRYPOINT []
CMD ["claude"]

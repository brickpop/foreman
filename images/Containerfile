# Foreman's agent image, phase 1: one image for every project, built by Foreman
# as localhost/foreman/harness (wiki/product/architecture/tech-stack.md#agent-images).
# A basic Debian box (adapted from pclaude's Dockerfile, github.com/brickpop/pclaude):
# Node, Bun, Go, just, the wiki CLI and common shell tools; anything more specialised
# comes from a workspace or project override later. The harnesses (Claude Code,
# Pi, Codex) are installed last, so updating them reuses every layer above.
# foreman-agent joins with the agent link.

FROM docker.io/library/node:26-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      openssh-client \
      less \
      jq \
      make \
      unzip \
      just \
      procps \
  && rm -rf /var/lib/apt/lists/*

# Go, pinned via build arg or resolved at build time with "latest".
ARG GO_VERSION=latest
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    ver="$GO_VERSION"; \
    if [ "$ver" = "latest" ]; then ver="$(curl -fsSL https://go.dev/VERSION?m=text | head -n1)"; fi; \
    case "$ver" in go*) ;; *) ver="go$ver" ;; esac; \
    curl -fsSL "https://go.dev/dl/${ver}.linux-${arch}.tar.gz" -o /tmp/go.tgz; \
    tar -C /usr/local -xzf /tmp/go.tgz; \
    rm /tmp/go.tgz /usr/local/go/test /usr/local/go/api -rf; \
    /usr/local/go/bin/go version

# The wiki CLI, pinned via build arg (a tag, e.g. v0.15.0) or the latest release.
# Keep it the version go.mod requires for github.com/agentic-wiki/wiki: the
# agents' CLI and Foreman's library must read a wiki by the same rules
# (TestWikiVersionMatchesGoMod).
ARG WIKI_VERSION=v0.16.2
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    if [ "$WIKI_VERSION" = "latest" ]; then from="latest/download"; else from="download/${WIKI_VERSION}"; fi; \
    mkdir -p /tmp/wiki && cd /tmp/wiki && \
    curl -fsSL -O "https://github.com/agentic-wiki/wiki/releases/${from}/wiki_linux_${arch}.tar.gz" && \
    tar xfz "wiki_linux_${arch}.tar.gz" && \
    mv ./wiki /usr/local/bin && \
    cd .. && \
    rm -Rf /tmp/wiki

ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global \
    GOPATH=/home/node/go \
    BUN_INSTALL=/home/node/.bun \
    PATH=/usr/local/share/npm-global/bin:/usr/local/go/bin:/home/node/go/bin:/home/node/.bun/bin:$PATH

RUN mkdir -p /usr/local/share/npm-global /home/node/.claude \
  && chown -R node:node /usr/local/share/npm-global /home/node/.claude

USER node

RUN curl -fsSL https://bun.sh/install | bash

# Last, because it moves fastest: a version bump reuses every layer above.
# Installed with npm because that is how Claude Code, Pi and Codex are distributed; this runs
# inside the agent image only (the Bun-only rule is about Foreman's own UI build).
ARG CLAUDE_CODE_VERSION=latest
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
  && npm cache clean --force

# Pi, the second harness (internal/harness/pi). Its install scripts aren't
# needed (Pi's own instructions skip them).
ARG PI_VERSION=latest
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@${PI_VERSION} \
  && npm cache clean --force

# Codex CLI, the third harness (internal/harness/codex).
ARG CODEX_VERSION=latest
RUN npm install -g @openai/codex@${CODEX_VERSION} \
  && npm cache clean --force

RUN node --version && bun --version && go version && claude --version && pi --version && codex --version && wiki --version

# The command is exactly what Foreman passes, and defaults to Claude.
ENTRYPOINT []
CMD ["claude"]
